{
  "name": "image-studio-uploader",
  "version": "3.1.0",
  "description": "Uploader gallerie Image Studio con GUI desktop",
  "author": "Image Studio",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "start:gui": "electron .",
    "dev": "electron .",
    "test": "node --test tests/*.test.js",
    "test:syntax": "node --check core/uploader-core.js && node --check electron/main.js && node --check electron/preload.js && node --check electron/renderer/renderer.js",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "firebase-admin": "^14.2.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.0.12",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.imagestudio.uploader",
    "productName": "Image Studio Uploader",
    "afterPack": "build/after-pack.cjs",
    "files": [
      "electron/**/*",
      "core/**/*",
      "assets/icon-uploader-v1/generated/icons/icon.ico",
      "config/firebase-config.js",
      "config/firebase-service-account.example.json",
      "uploader-pc.js",
      "CREDENZIALI-FIREBASE.txt",
      "package.json",
      "favicon.ico"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "assets/icon-uploader-v1/generated/icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Image Studio Uploader",
      "include": "build/installer.nsh",
      "installerIcon": "assets/icon-uploader-v1/generated/icons/icon.ico",
      "uninstallerIcon": "assets/icon-uploader-v1/generated/icons/icon.ico",
      "installerHeaderIcon": "assets/icon-uploader-v1/generated/icons/icon.ico"
    }
  }
}
